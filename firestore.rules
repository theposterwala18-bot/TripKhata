rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isOwnUser(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function tripPath(tripId) {
      return /databases/$(database)/documents/sharedTrips/$(tripId);
    }

    function memberPath(tripId, uid) {
      return /databases/$(database)/documents/sharedTrips/$(tripId)/members/$(uid);
    }

    function isTripMember(tripId) {
      return signedIn() && exists(memberPath(tripId, request.auth.uid));
    }

    function memberRole(tripId) {
      return get(memberPath(tripId, request.auth.uid)).data.role;
    }

    function isTripOwner(tripId) {
      return signedIn()
        && exists(tripPath(tripId))
        && get(tripPath(tripId)).data.ownerUid == request.auth.uid;
    }

    function isTripOwnerAfter(tripId) {
      return signedIn()
        && getAfter(tripPath(tripId)).data.ownerUid == request.auth.uid;
    }

    function canEditTrip(tripId) {
      return isTripMember(tripId)
        && memberRole(tripId) in ['owner', 'admin', 'member'];
    }

    match /users/{uid} {
      allow read, write: if isOwnUser(uid);

      match /{document=**} {
        allow read, write: if isOwnUser(uid);
      }
    }

    match /sharedTripInvites/{inviteCode} {
      allow get: if signedIn();
      allow list: if false;

      allow create: if signedIn()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.active == true
        && request.resource.data.tripId is string;

      allow update, delete: if signedIn()
        && resource.data.ownerUid == request.auth.uid;
    }

    match /sharedTrips/{tripId} {
      allow create: if signedIn()
        && request.resource.data.ownerUid == request.auth.uid;

      allow get: if isTripMember(tripId);
      allow list: if false;

      allow update, delete: if isTripOwner(tripId);

      match /members/{memberId} {
        allow get: if signedIn()
          && (memberId == request.auth.uid || isTripMember(tripId));

        allow list: if isTripMember(tripId);

        allow create: if signedIn()
          && memberId == request.auth.uid
          && (
            (
              request.resource.data.role == 'owner'
              && isTripOwnerAfter(tripId)
            )
            ||
            (
              request.resource.data.role == 'member'
              && request.resource.data.inviteCode is string
              && exists(/databases/$(database)/documents/sharedTripInvites/$(request.resource.data.inviteCode))
              && get(/databases/$(database)/documents/sharedTripInvites/$(request.resource.data.inviteCode)).data.active == true
              && get(/databases/$(database)/documents/sharedTripInvites/$(request.resource.data.inviteCode)).data.tripId == tripId
            )
          );

        allow update: if isTripOwner(tripId);

        allow delete: if signedIn()
          && (memberId == request.auth.uid || isTripOwner(tripId));
      }

      match /state/{stateId} {
        allow read: if isTripMember(tripId);

        allow create: if isTripOwnerAfter(tripId) || canEditTrip(tripId);
        allow update: if canEditTrip(tripId);
        allow delete: if isTripOwner(tripId);
      }

      match /audit/{auditId} {
        allow read: if isTripMember(tripId);

        allow create: if canEditTrip(tripId);
        allow update: if false;
        allow delete: if isTripOwner(tripId);
      }
    }

    /* Connected Khata remains isolated beta.
       A signed-in user must know the random request code.
       Listing all requests is never allowed. */
    match /connectedKhataRequests/{requestCode} {
      allow get: if signedIn();
      allow list: if false;

      allow create: if signedIn()
        && request.resource.data.requester.uid == request.auth.uid;

      allow update: if signedIn()
        && (
          resource.data.requester.uid == request.auth.uid
          || resource.data.status == 'pending'
          || resource.data.acceptor.uid == request.auth.uid
        );

      allow delete: if signedIn()
        && resource.data.requester.uid == request.auth.uid;
    }
  }
}
